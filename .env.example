# ===========================================
# REQUIRED ENVIRONMENT VARIABLES FOR DEPLOYMENT
# ===========================================

# Database Connection (Vercel Postgres or external PostgreSQL)
# For Vercel Postgres: Use the connection string from Vercel dashboard
# Format: postgresql://user:password@host:5432/database?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/database?schema=public"

# NextAuth.js Configuration
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Add authorized redirect URI: https://your-domain.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Resend Email Service (https://resend.com)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="Price Tracker <noreply@your-verified-domain.com>"

# ===========================================
# OPTIONAL - FOR N8N WORKFLOW
# ===========================================

# OpenAI API Key for n8n price extraction
OPENAI_API_KEY="sk-your-openai-api-key"

# n8n Webhook URL for triggering immediate price checks
# Get this URL after importing the workflow in n8n
N8N_WEBHOOK_URL="https://your-n8n-instance.railway.app/webhook/check-price"

# ===========================================
# AUTO-SET BY VERCEL (do not set manually)
# ===========================================
# VERCEL_URL - automatically set by Vercel
# NEXTAUTH_URL - automatically derived from VERCEL_URL
